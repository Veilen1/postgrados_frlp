# =============================================================================
# .env.example — Plantilla de Variables de Entorno (Sistema de Posgrado UTN FRLP)
# Copiar este archivo a .env:
#   cp .env.example .env
# =============================================================================

# Base de Datos PostgreSQL
DB_USER=postgrado_user
DB_PASSWORD=postgrado_dev_password
DB_NAME=postgrado_dev
DB_PORT=5432
DATABASE_URL=postgresql://postgrado_user:postgrado_dev_password@db:5432/postgrado_dev

# Seguridad y Autenticación JWT (Generar secreto robusto para producción)
JWT_SECRET=super_secret_jwt_key_for_dev_mode_utn_posgrado_2026_at_least_32_chars
JWT_EXPIRATION=28800
JWT_REFRESH_EXPIRATION=604800

# Almacenamiento Seguro de PDFs
STORAGE_PATH=/var/postgrado-storage
MAX_FILE_SIZE_MB=5

# Integración y Red
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:8000/api/v1
ENVIRONMENT=development
